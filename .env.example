SITE_DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost
# Host port for Caddy. Use 8080 when something else (e.g. another compose project) holds port 80.
HTTP_PORT=8080
WEB_PORT=3000
API_PORT=8000
DB_PORT=5433

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
DATABASE_URL=postgresql+asyncpg://portfolio:change-me@db:5432/portfolio

S3_PORT=9100
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=storage-change-me
S3_SECRET_KEY=storage-change-me-too
S3_BUCKET=portfolio
# Largest single image accepted by the admin upload
MAX_UPLOAD_MB=8

# false on http://admin.localhost, true once served over HTTPS
COOKIE_SECURE=false
SESSION_DAYS=14
LOGIN_ATTEMPTS_PER_MINUTE=5

# Optional GitHub login. Create an OAuth app at github.com/settings/developers with the callback
# http://admin.localhost:8080/auth/github/callback, then fill these in. Leave empty to turn it off.
# A GitHub login works only for a user whose GitHub account was linked on the /account page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Behind the Caddy proxy the visitor's address comes from X-Forwarded-For, used for the rate limits.
# Set false if the api is ever reachable without the proxy, otherwise a visitor could fake it.
TRUST_FORWARDED_FOR=true

# Question box (POST /api/ask). Without a key it still runs, but only points to the matching parts of the site.
# Get a key at aistudio.google.com and check the real free-tier quota of your own account there.
# Note: prompts on the free tier may be used by Google to improve its products, so keep anything private
# out of the site text. Questions are logged on your own server (/rag/questions in the admin).
GEMINI_API_KEY=
# Model for confident matches, and for partial matches where the wording matters more
GEMINI_MODEL_CHEAP=gemini-2.5-flash-lite
GEMINI_MODEL_SMART=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20
# Per visitor: questions per day and per minute. Greetings and refused questions count too.
ASK_PER_IP_PER_DAY=30
ASK_PER_MINUTE=6
# Days a model-written answer is reused for the same question (a rebuild of the index also clears it)
ASK_CACHE_DAYS=7
# Asks are logged with a salted hash of the IP, not the IP. Change the salt to any random text.
ASK_IP_SALT=change-me-to-random-text
