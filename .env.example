SITE_DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost
# Host port for Caddy. Use 8080 when something else (e.g. another compose project) holds port 80.
HTTP_PORT=8080
WEB_PORT=3000
API_PORT=8000
DB_PORT=5433

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
DATABASE_URL=postgresql+asyncpg://portfolio:change-me@db:5432/portfolio

S3_PORT=9000
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=storage-change-me
S3_SECRET_KEY=storage-change-me-too
S3_BUCKET=portfolio
# Largest single image accepted by the admin upload
MAX_UPLOAD_MB=8

# false on http://admin.localhost, true once served over HTTPS
COOKIE_SECURE=false
SESSION_DAYS=14
LOGIN_ATTEMPTS_PER_MINUTE=5

GEMINI_API_KEY=
