# Production settings. On the server: copy this file to .env, then replace every value marked CHANGE-ME.
# The secrets can be generated for you:   sh ops/gen-secrets.sh
# .env is git-ignored. Never commit real secrets. DEPLOY.md walks through the whole procedure.

# Use the production overrides with plain `docker compose ...` commands (HTTPS, restarts, capped logs).
# (COMPOSE_PATH_SEPARATOR makes the ":" work on Windows too, where compose would otherwise expect ";")
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Domains ---------------------------------------------------------------------------------------------
# Two host names, both with DNS records pointing at this machine. The admin lives on its own host name.
SITE_DOMAIN=CHANGE-ME.example.com
ADMIN_DOMAIN=admin.CHANGE-ME.example.com
# Public address of the site (used in the sitemap and link previews)
SITE_URL=https://CHANGE-ME.example.com
# Let's Encrypt writes to this address if a certificate cannot be renewed
ACME_EMAIL=CHANGE-ME@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Only these addresses may open the admin host (everyone else gets 403). Space-separated, addresses or ranges.
# Leave the line out to allow everyone (the login is still password + TOTP).
# ADMIN_ALLOWED_IPS=203.0.113.7 198.51.100.0/24

# --- Database --------------------------------------------------------------------------------------------
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio
POSTGRES_PASSWORD=CHANGE-ME
# The password here must be the same as POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://portfolio:CHANGE-ME@db:5432/portfolio

# --- Object storage (images and CVs) ---------------------------------------------------------------------
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=CHANGE-ME
S3_SECRET_KEY=CHANGE-ME
S3_BUCKET=portfolio
MAX_UPLOAD_MB=8

# --- Admin sessions --------------------------------------------------------------------------------------
# true: the session cookie is only sent over HTTPS (required once the site is on HTTPS)
COOKIE_SECURE=true
SESSION_DAYS=14
LOGIN_ATTEMPTS_PER_MINUTE=5
# Behind the Caddy proxy the visitor's address comes from X-Forwarded-For. Keep true while the proxy is the only way in.
TRUST_FORWARDED_FOR=true

# Optional GitHub login (all three, or none). Callback: https://admin.CHANGE-ME.example.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# --- Question box ----------------------------------------------------------------------------------------
# Without a key the box still runs, but only points visitors to the matching parts of the site.
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=20
ASK_PER_IP_PER_DAY=30
ASK_PER_MINUTE=6
ASK_CACHE_DAYS=7
ASK_LOG_DAYS=90
# Questions are logged with a salted hash of the IP. Any long random text.
ASK_IP_SALT=CHANGE-ME

# --- Backups (used by ops/backup.sh) ---------------------------------------------------------------------
# Where backups are written on this machine, and how many to keep
BACKUP_DIR=/var/backups/portfolio
BACKUP_KEEP=14
# Optional: also copy each backup to another place with rclone (e.g. a cloud bucket): rclone remote and path
# BACKUP_REMOTE=mybucket:portfolio-backups
